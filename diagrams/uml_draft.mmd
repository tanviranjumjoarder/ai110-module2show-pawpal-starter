classDiagram
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +all_tasks() List
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
    }
    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
    }
    Owner "1" *-- "many" Pet : has
    Pet "1" *-- "many" Task : has
    Scheduler --> Owner : reads tasks from
